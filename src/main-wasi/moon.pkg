import {
  "nathsou/yodl/lib/utils",
  "nathsou/yodl/lib/driver",
  "moonbitlang/core/encoding/utf8",
  "peter-jerry-ye/wasi",
  "peter-jerry-ye/wasi/fs",
  "peter-jerry-ye/wasi/stdio",
  "peter-jerry-ye/wasi/sync_io"
}

supported_targets = "+wasm"

options(
  link: {
    "wasm": { "export-memory-name": "memory", "exports": ["start:_start"] }, 
  },
  "is-main": false,
)