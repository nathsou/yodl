module Top(
    clk:     clock,
    wr_en:   bool,
    wr_addr: uint<4>,
    wr_data: uint<8>,
    rd_en:   bool,
    rd_addr: uint<4>,
) -> (
    rd_data: uint<8>,
) {
    let mem = Memory<
        T:           uint<8>,
        Depth:       16,
        ReadPorts:   1,
        WritePorts:  1,
        ReadLatency:  1,
        WriteLatency: 1,
    >(
        read:  [{ clk: clk, en: rd_en,  addr: rd_addr }],
        write: [{ clk: clk, en: wr_en, addr: wr_addr, data: wr_data, mask: true }],
    )
    rd_data = mem.q[0]
}
