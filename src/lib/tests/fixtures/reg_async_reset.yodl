// Exercises ExpandWhensPass with RegReset (async reset) + en port:
// Emits a RegReset stmt (scope[reg] = Some(reg) self-init) followed by
// a no-else When { cond: en, body: [reg = d] }.
// Merge: Mux(en, d, reg_q). Also covers the RegReset stmt path in process_block.
module Top(clk: clock, rst: bool, en: bool, d: u8) -> (q: u8) {
    let reg = RegAsyncReset<u8>(clk, rst: rst, en: en)
    reg.d = d
    q = reg.q
}
