module Top(
    a: u8,
    b: u8,
) -> (
    out_and:  u8,
    out_or:   u8,
    out_xor:  u8,
    out_nand: u8,
    out_nor:  u8,
    out_xnor: u8,
    out_not:  u8,
) {
    out_and  = a and b
    out_or   = a or b
    out_xor  = a xor b
    out_nand = a nand b
    out_nor  = a nor b
    out_xnor = a xnor b
    out_not  = not a
}
