// Exercises ExpandConnectsPass dynamic indexing:
//   - DynamicIndexing on RHS (rewrite_ref with DynamicIndexing -> mux-tree read)
//   - DynamicIndexing on LHS (rewrite_connect_stmt -> mux-tree write)
module Top(
    a:      u8[4],
    rd_idx: u2,
    wr_idx: u2,
    wr_val: u8,
) -> (
    out:    u8[4],
    rd_val: u8,
) {
    out      = a
    out[wr_idx] = wr_val
    rd_val   = out[rd_idx]
}
