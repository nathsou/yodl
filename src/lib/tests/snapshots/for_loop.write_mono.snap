const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)> }[ReadPorts],
  write: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T> }[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  a: uint<8>[4],
  mask: uint<8>,
) -> (
  out: uint<8>[4],
) {
  {
    {
      out[0] = (a[0] xor mask);
    }
    {
      out[1] = (a[1] xor mask);
    }
    {
      out[2] = (a[2] xor mask);
    }
    {
      out[3] = (a[3] xor mask);
    }
  }
}
