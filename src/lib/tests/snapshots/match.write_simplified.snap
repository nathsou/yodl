@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: u1, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  sel: u2,
  a: u8,
  b: u8,
  c: u8,
) -> (
  out: u8,
) {
  out = match sel {
    2'd0 => a,
    2'd1 => b,
    2'd2 => c,
    _ => 8'd000,
  };
}
