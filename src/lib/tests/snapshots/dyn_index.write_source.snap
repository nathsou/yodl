const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)> }[ReadPorts],
  write: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T> }[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  a: uint<8>[4],
  rd_idx: uint<2>,
  wr_idx: uint<2>,
  wr_val: uint<8>,
) -> (
  out: uint<8>[4],
  rd_val: uint<8>,
) {
  out = a;
  out[wr_idx] = wr_val;
  rd_val = out[rd_idx];
}
