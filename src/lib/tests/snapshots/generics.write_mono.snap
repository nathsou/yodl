@internal
module Memory[T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat](
  read: [ReadPorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>),
  write: [WritePorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask[T]),
