module Identity$0(
  a: u8,
) -> (
  out: u8,
) {
  out = a;
}
module Identity$1(
  a: u16,
) -> (
  out: u16,
) {
  out = a;
}
module Top(
  a: u8,
  b: u16,
) -> (
  x: u8,
  y: u16,
) {
  let ix = Identity$0(a: a);
  let iy = Identity$1(a: b);
  x = ix.out;
  y = iy.out;
}
