const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)> }[ReadPorts],
  write: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T> }[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  a: uint<8>,
  b: uint<8>,
) -> (
  eq: uint<1>,
  ne: uint<1>,
  lt: uint<1>,
  le: uint<1>,
  gt: uint<1>,
  ge: uint<1>,
) {
  eq = (a == b);
  ne = (a != b);
  lt = (a <: b);
  le = (a <= b);
  gt = (a >: b);
  ge = (a >= b);
}
