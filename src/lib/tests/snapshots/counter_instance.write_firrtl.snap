FIRRTL version 4.1.0
circuit Top:
  public module Counter$0:
    input clk: Clock
    input rst: UInt<1>
    output q: UInt<24>

    regreset r: UInt<24>, clk, rst, UInt<24>(0)
    connect r, bits(add(r, UInt<1>(1)), 23, 0)
    connect q, r

  public module Top:
    input clk: Clock
    input rst: UInt<1>
    output leds: UInt<16>

    inst counter of Counter$0
    connect counter.clk, clk
    connect counter.rst, rst
    connect leds, bits(counter.q, 23, 8)

