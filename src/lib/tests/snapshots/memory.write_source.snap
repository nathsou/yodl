const true = 1'b1;
const false = 1'b0;
@internal
module Reg[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory[T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat](
  read: [ReadPorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>),
  write: [WritePorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask[T]),
) -> (
  q: [ReadPorts]T,
)
module Top(
  clk: clock,
  wr_en: u1,
  wr_addr: u4,
  wr_data: u8,
  rd_en: u1,
  rd_addr: u4,
) -> (
  rd_data: u8,
) {
  let mem = Memory[T: u8, Depth: 16, ReadPorts: 1, WritePorts: 1, ReadLatency: 1, WriteLatency: 1](read: [(clk: clk, en: rd_en, addr: rd_addr)], write: [(clk: clk, en: wr_en, addr: wr_addr, data: wr_data, mask: true)]);
  rd_data = mem.q[0];
}
