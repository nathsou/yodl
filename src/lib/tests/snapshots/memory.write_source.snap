const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  clk: clock,
  wr_en: uint<1>,
  wr_addr: uint<4>,
  wr_data: uint<8>,
  rd_en: uint<1>,
  rd_addr: uint<4>,
) -> (
  rd_data: uint<8>,
) {
  let mem = Memory<T: uint<8>, Depth: 16, ReadPorts: 1, WritePorts: 1, ReadLatency: 1, WriteLatency: 1>(read: [(clk: clk, en: rd_en, addr: rd_addr)], write: [(clk: clk, en: wr_en, addr: wr_addr, data: wr_data, mask: true)]);
  rd_data = mem.q[0];
}
