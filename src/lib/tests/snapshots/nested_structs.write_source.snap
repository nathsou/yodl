const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
type Point = (x: uint<8>, y: uint<8>);
module Dot(
  a: Point,
  b: Point,
) -> (
  result: uint<17>,
) {
  result = ((a.x * b.x) + (a.y * b.y));
}
module Top(
  p: Point,
  q: Point,
) -> (
  dot: uint<17>,
) {
  let d = Dot(a: p, b: q);
  dot = d.result;
}
