const true = 1'b1;
const false = 1'b0;
@internal
module Reg[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory[T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat](
  read: [ReadPorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>),
  write: [WritePorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask[T]),
) -> (
  q: [ReadPorts]T,
)
type Point = (x: u8, y: u8);
module Dot(
  a: Point,
  b: Point,
) -> (
  result: u17,
) {
  result = ((a.x * b.x) + (a.y * b.y));
}
module Top(
  p: Point,
  q: Point,
) -> (
  dot: u17,
) {
  let d = Dot(a: p, b: q);
  dot = d.result;
}
