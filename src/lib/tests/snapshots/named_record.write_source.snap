const true = 1'b1;
const false = 1'b0;
@internal
module Reg[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory[T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat](
  read: [ReadPorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>),
  write: [WritePorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask[T]),
) -> (
  q: [ReadPorts]T,
)
type Color = (r: u3, g: u3, b: u3);
module Top(
  rin: u3,
  gin: u3,
  bin: u3,
) -> (
  out: Color,
  copy: Color,
) {
  let base = (r: rin, g: gin, b: bin);
  out = base;
  copy = (..base, g: 3'd0);
}
