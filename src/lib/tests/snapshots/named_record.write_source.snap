const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
type Color = (r: uint<3>, g: uint<3>, b: uint<3>);
module Top(
  rin: uint<3>,
  gin: uint<3>,
  bin: uint<3>,
) -> (
  out: Color,
  copy: Color,
) {
  let base = (r: rin, g: gin, b: bin);
  out = base;
  copy = (..base, g: 3'd0);
}
