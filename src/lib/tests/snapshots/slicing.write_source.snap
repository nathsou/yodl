const true = 1'b1;
const false = 1'b0;
@internal
module Reg[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset[T: Type](
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory[T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat](
  read: [ReadPorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>),
  write: [WritePorts](clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask[T]),
) -> (
  q: [ReadPorts]T,
)
module Top(
  a: u8,
) -> (
  hi_nibble: u4,
  lo_nibble: u4,
  bit0: u1,
  nibble_desc: u4,
  nibble_asc: u4,
) {
  hi_nibble = a[7:4];
  lo_nibble = a[3:0];
  bit0 = a[0];
  nibble_desc = a[7-:4];
  nibble_asc = a[4+:4];
}
