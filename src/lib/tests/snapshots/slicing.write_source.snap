const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)> }[ReadPorts],
  write: { clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T> }[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  a: uint<8>,
) -> (
  hi_nibble: uint<4>,
  lo_nibble: uint<4>,
  bit0: uint<1>,
  nibble: uint<4>,
) {
  hi_nibble = a[7:4];
  lo_nibble = a[3:0];
  bit0 = a[0];
  nibble = a[7-:4];
}
