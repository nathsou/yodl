const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
module DFF(
  clk: clock,
  d: uint<1>,
) -> (
  q: uint<1>,
)
module Top(
  clk: clock,
  d: uint<1>,
) -> (
  q: uint<1>,
) {
  let ff = DFF(clk: clk, d: d);
  q = ff.q;
}
