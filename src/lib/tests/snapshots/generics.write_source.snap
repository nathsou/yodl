const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: u1,
  rst?: u1,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: u1, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: u1, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Identity<N: Nat>(
  a: uint<N>,
) -> (
  out: uint<N>,
) {
  out = a;
}
module Top(
  a: u8,
  b: u16,
) -> (
  x: u8,
  y: u16,
) {
  let ix = Identity<8>(a: a);
  let iy = Identity<16>(a: b);
  x = ix.out;
  y = iy.out;
}
