const true = 1'b1;
const false = 1'b0;
@internal
module Reg<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module RegAsyncReset<T: Type>(
  clk: clock,
  d: T,
  en?: uint<1>,
  rst?: uint<1>,
) -> (
  q: T,
)
@internal
module Memory<T: Type, Depth: Nat, ReadPorts: Nat, WritePorts: Nat, ReadLatency: Nat, WriteLatency: Nat>(
  read: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>)[ReadPorts],
  write: (clk: clock, en: uint<1>, addr: uint<clog2!(Depth)>, data: T, mask: MemoryMask<T>)[WritePorts],
) -> (
  q: T[ReadPorts],
)
module Top(
  u4: uint<4>,
  s4: sint<4>,
) -> (
  zext_u4_u8: uint<8>,
  sext_s4_s8: sint<8>,
  sext_u4_u8: uint<8>,
) {
  zext_u4_u8 = pad!(u4, 8);
  sext_s4_s8 = pad!(s4, 8);
  sext_u4_u8 = uint!(pad!(sint!(u4), 8));
}
