{
    "type": "commonjs",
    "name": "yodl",
    "main": "_build/js/release/build/main/main.min.js",
    "types": "_build/js/release/build/main/main.d.ts",
    "description": "Modern Hardware Description Language",
    "version": "0.2.2",
    "files": [
        "_build/js/release/build/main/main.min.js",
        "_build/js/release/build/main/main.d.ts",
        "_build/js/release/build/main/main.mi",
        "_build/js/release/build/main/main.core",
        "_build/js/release/build/main/moonbit.d.ts"
    ],
    "bin": {
        "yodl": "_build/js/release/build/main/main.min.js"
    },
    "scripts": {
        "prepublishOnly": "moon build src/main --target=js --release && bunx esbuild@0.27.2 _build/js/release/build/main/main.js --minify --outfile=_build/js/release/build/main/main.min.js && perl -pi -e 'print \"#!/usr/bin/env node\\n\" if $.==1' _build/js/release/build/main/main.min.js",
        "build-wasi": "moon build src/main-wasi/ --target=wasm --release && cp _build/wasm/release/build/main-wasi/main-wasi.wasm ./res/yodl-wasi.wasm"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nathsou/yodl.git"
    }
}