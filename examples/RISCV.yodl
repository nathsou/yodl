// https://github.com/BrunoLevy/learn-fpga/blob/master/FemtoRV/TUTORIALS/FROM_BLINKER_TO_RISCV/README.md

package Inst {
    const ALU_REG = 7'b0110011; // rd <- rs1 OP rs2
    const ALU_IMM = 7'b0010011; // rd <- rs1 OP Iimm
    const BRANCH = 7'b1100011; // if(rs1 OP rs2) PC<-PC+Bimm
    const JALR = 7'b1100111; // rd <- PC+4; PC<-rs1+Iimm
    const JAL = 7'b1101111; // rd <- PC+4; PC<-PC+Jimm
    const AUIPC = 7'b0010111; // rd <- PC + Uimm
    const LUI = 7'b0110111; // rd <- Uimm
    const LOAD = 7'b0000011; // rd <- mem[rs1+Iimm]
    const STORE = 7'b0100011; // mem[rs1+Simm] <- rs2
    const SYSTEM = 7'b1110011; // special
}

package Stage {
    const FETCH_INST = 3'd0;
    const WAIT_INST = 3'd1;
    const FETCH_REGS = 3'd2;
    const EXECUTE = 3'd3;
    const LOAD = 3'd4;
    const WAIT_DATA = 3'd5;
    const STORE = 3'd6;
}

module RAM(
    clk: clock,
    addr: uint<32>,
    read_enable: bool,
    write_data: uint<8>[4],
    mask: bool[4],
) -> (
    q: uint<32>,
) {
    // divide addr by 4 (byte address to word address)
    let word_addr = addr[9:2];

    let mem = Memory<
        T: uint<8>[4],
        Depth: 256,
        ReadPorts: 1,
        WritePorts: 1,
        Mask: bool[4],
    >(
        read: [{ clk: clk, en: read_enable, addr: word_addr }],
        write: [{ clk: clk, en: true, addr: word_addr, data: write_data, mask: mask }],
    );

    $readmemb("/Volumes/S/code/moonbit/yodl/sim/riscv/riscv_prog.mem", mem);

    let data = mem.q[0];
    q = uint([data[3], data[2], data[1], data[0]]);
}

module Flip<N: uint>(d: uint<N>) -> (q: uint<N>) {
    let flipped: bool[N];

    for i in 0..<N {
        flipped[i] = d[i];
    }

    // uint flips the bits from [0..N] to [N..0]
    q = uint(flipped);
}

module CPU(
    clk: clock,
    rst: bool,
    mem_read_data: uint<32>,
) -> (
    mem_addr: uint<32>,
    mem_read_enable: bool,
    mem_write_data: uint<8>[4],
    mem_write_mask: bool[4],
    status: uint<32>,
) {
    let inst = Reg<uint<32>>(clk, rst);
    let opcode = inst.q[6:0];
    let is_alu_reg = opcode == Inst::ALU_REG;
    let is_alu_imm = opcode == Inst::ALU_IMM;
    let is_branch = opcode == Inst::BRANCH;
    let is_jalr = opcode == Inst::JALR;
    let is_jal = opcode == Inst::JAL;
    let is_auipc = opcode == Inst::AUIPC;
    let is_lui = opcode == Inst::LUI;
    let is_load = opcode == Inst::LOAD;
    let is_store = opcode == Inst::STORE;
    let is_system = opcode == Inst::SYSTEM;

    let imm_u = uint({inst.q[31:12], 12*{1'b0}});
    let imm_i = uint({21*{inst.q[31]}, inst.q[30:20]});
    let imm_s = uint({21*{inst.q[31]}, inst.q[30:25], inst.q[11:7]});
    let imm_b = uint({20*{inst.q[31]}, inst.q[7], inst.q[30:25], inst.q[11:8], 1'b0});
    let imm_j = uint({12*{inst.q[31]}, inst.q[19:12], inst.q[20], inst.q[30:21], 1'b0});

    let rs1_addr = inst.q[19:15];
    let rs2_addr = inst.q[24:20];
    let rd_addr = inst.q[11:7];

    let funct3 = inst.q[14:12];
    let funct7 = inst.q[31:25];
    
    let stage = Reg<uint<3>>(clk, rst);
    let pc = Reg<uint<32>>(clk, rst);
    let rs1 = Reg<uint<32>>(clk, rst);
    let rs2 = Reg<uint<32>>(clk, rst);
    let regs = 32*[Reg<uint<32>>(clk, rst)];

    // TODO: make this automatic
    for i in 0..<32 {
        regs[i].d = regs[i].q;
    }

    let alu_in1 = rs1.q;
    let alu_in2 = is_alu_reg or is_branch ? rs2.q : imm_i;
    let alu_plus = alu_in1 + alu_in2;
    let alu_minus: uint<33> = uint({1'b0, alu_in1}) - uint({1'b0, alu_in2});
    let alu_equ = alu_minus[31:0] == 32'b0;
    let alu_lss_unsigned = alu_minus[32];
    let alu_lss_signed = alu_in1[31] xor alu_in2[31] ? alu_in1[31] : alu_minus[31];
    let shifter_in = funct3 == 3'd1 ? Flip<32>(d: alu_in1).q : alu_in1;
    let shifter: uint<32> = sint({inst.q[30] and alu_in1[31], shifter_in}) shr alu_in2[4:0];
    let left_shift = Flip<32>(d: shifter).q;

    let alu_out = match funct3 {
        3'b000 => (funct7[5] and inst.q[5] ? alu_minus : alu_plus)[31:0],
        3'b001 => left_shift,
        3'b010 => uint({31'b0, alu_lss_signed}),
        3'b011 => uint({31'b0, alu_lss_unsigned}),
        3'b100 => alu_in1 xor alu_in2,
        3'b101 => shifter,
        3'b110 => alu_in1 or alu_in2,
        3'b111 => alu_in1 and alu_in2,
    };

    let is_jump_inst = is_jal or is_jalr;
    let next_addr: uint<32> = pc.q + 4;
    let inst_imm = inst.q[3] ? imm_j : inst.q[4] ? imm_u : imm_b;
    let pc_plus_imm: uint<32> = pc.q + inst_imm;
    let write_back_enable = (stage.q == Stage::EXECUTE and (not is_branch) and (not is_store) and (not is_load)) or stage.q == Stage::WAIT_DATA;
    let write_back_data = is_jump_inst ? next_addr : is_lui ? imm_u : is_auipc ? pc_plus_imm : alu_out;

    let take_branch = match funct3 {
        3'b000 => alu_equ,
        3'b001 => not alu_equ,
        3'b100 => alu_lss_signed,
        3'b101 => not alu_lss_signed,
        3'b110 => alu_lss_unsigned,
        3'b111 => not alu_lss_unsigned,
        _ => false,
    };
    
    let next_pc = (is_branch and take_branch) or is_jal ? pc_plus_imm :
                  is_jalr ? uint({alu_plus[31:1], 1'b0}) :
                  next_addr;

    let load_store_addr: uint<32> = rs1.q + (is_store ? imm_s : imm_i);
    let load_half_word = load_store_addr[1] ? mem_read_data[31:16] : mem_read_data[15:0];
    let load_byte = load_store_addr[0] ? load_half_word[15:8] : load_half_word[7:0];
    let byte_access = funct3[1:0] == 2'd0;
    let half_word_access = funct3[1:0] == 2'd1;
    let load_sign = (not funct3[2]) and byte_access ? load_byte[7] : load_half_word[15];
    let load_data = byte_access ? uint({24*{load_sign}, load_byte}) :
        half_word_access ? uint({16*{load_sign}, load_half_word}) :
        mem_read_data;

    mem_write_data = [
        load_store_addr[0] ? rs2.q[7:0] : load_store_addr[1] ? rs2.q[15:8] : rs2.q[31:24],
        load_store_addr[1] ? rs2.q[7:0] : rs2.q[23:16],
        load_store_addr[0] ? rs2.q[7:0] : rs2.q[15:8],
        rs2.q[7:0],
    ];

    let mask = byte_access ?
        (load_store_addr[1] ?
            (load_store_addr[0] ? 4'b1000 : 4'b0100) :
            (load_store_addr[0] ? 4'b0010 : 4'b0001)
        ) : (
            half_word_access ?
            (load_store_addr[1] ? 4'b1100 : 4'b0011) :
            4'b1111
        );
    
    mem_write_mask = is_store ? [mask[3], mask[2], mask[1], mask[0]] : 4*[false];

    pc.d = pc.q;
    inst.d = inst.q;
    stage.d = stage.q;
    rs1.d = rs1.q;
    rs2.d = rs2.q;

    if rst {
        pc.d = 32'd0;
        stage.d = Stage::FETCH_INST;
    } else {
        if write_back_enable and rd_addr != 5'd0 {
            regs[rd_addr].d = write_back_data;
        }

        match stage.q {
            Stage::FETCH_INST => {
                stage.d = Stage::WAIT_INST;
            },
            Stage::WAIT_INST => {
                inst.d = mem_read_data;
                $printf(clk, true, "inst: %b, pc: %h, status: %b\n", inst.q, pc.q, status);
                stage.d = Stage::FETCH_REGS;
            },
            Stage::FETCH_REGS => {
                rs1.d = regs[rs1_addr].q;
                rs2.d = regs[rs2_addr].q;
                stage.d = Stage::EXECUTE;
            },
            Stage::EXECUTE => {
                if not is_system {
                    pc.d = next_pc;
                    stage.d = is_load ? Stage::LOAD : is_store ? Stage::STORE : Stage::FETCH_INST;
                } else {
                    $stop(clk, true, 0);
                }
            },
            Stage::LOAD => {
                stage.d = Stage::WAIT_DATA;
            },
            Stage::WAIT_DATA => {
                stage.d = Stage::FETCH_INST;
            },
            Stage::STORE => {
                stage.d = Stage::FETCH_INST;
            },
        }
    }

    mem_addr = stage.q == Stage::WAIT_INST or stage.q == Stage::FETCH_INST ? pc.q : load_store_addr;
    mem_read_enable = stage.q == Stage::FETCH_INST or stage.q == Stage::LOAD;
    status = uint({8'd0, uint(clk), opcode, 5'd0, stage.q, regs[1].q[7:0]});
}

module Top(
    clk: clock,
    rst_n: bool,
) -> (
    io_led: uint<24>,
) {
    let rst = not rst_n;
    let ram = RAM(clk);
    let cpu = CPU(
        clk,
        rst,
        mem_addr: ram.addr,
        mem_read_data: ram.q,
        mem_read_enable: ram.read_enable,
        mem_write_data: ram.write_data,
        mem_write_mask: ram.mask,
    );

    io_led = cpu.status[23:0];
}
