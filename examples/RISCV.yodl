import RISCVCore
import UART

module RAM(
    clk: clock,
    addr: u32,
    read_enable: bool,
    write_data: [4]u8,
    mask: [4]bool,
) -> (
    q: u32,
) {
    let mem = Memory[
        T: [4]u8,
        Depth: (6 * 1024) / 4, // 6KB
        ReadPorts: 1,
        WritePorts: 1,
    ](
        read: [(clk: clk, en: read_enable, addr: addr[10:0])],
        write: [(clk: clk, en: true, addr: addr[10:0], data: write_data, mask: mask)],
    )

    readmemh!("prog.hex", mem)

    q = uint!(mem.q[0])
}

// One-hot encoding of MMIO devices
package MemoryMappedIO {
    const LEDs = 0
    const UART_DATA = 1
    const UART_BUSY = 2
}

const CLOCK_FREQ = 100_000_000 // 100 MHz

module Top(
    clk: clock,
    rst_n: bool,
) -> (
    usb_tx: u1,
    led: u8,
    io_led: u24,
    halted: bool,
    trap: bool,
) {
    // All state uses the physical clock. The divider produces a clock enable,
    // so asserting rst_n resets the CPU even between enabled CPU cycles.
    let rst = not rst_n

    let counter = Reg[u2](clk, rst)
    counter.d = counter.q + 1'b1
    let cpu_enable = counter.q == 3

    let ram = RAM(clk)
    let cpu = RISCVCore::CPU(
        clk,
        enable: cpu_enable,
        rst,
    )

    let word_addr = cat!(2'b0, cpu.mem_addr[31:2]) // divide by 4
    ram.addr = word_addr

    let is_io = cpu.mem_addr[22]
    let is_ram = not is_io

    let uart_transmitter = UART::Transmitter[
        ClockFreq: CLOCK_FREQ,
        BaudRate: 921600,
    ](
        clk,
        rst,
        tx: usb_tx,
        data_in: cpu.mem_write_data[0],
    )

    let write_request = orr uint!(cpu.mem_write_mask)

    // A CPU request is accepted only on an enabled CPU cycle. UART writes
    // additionally wait until the transmitter can accept the byte.
    let uart_write = is_io and write_request and word_addr[MemoryMappedIO::UART_DATA]
    let request_target_ready = (not uart_write) or uart_transmitter.ready
    let request_ready = cpu_enable and request_target_ready
    cpu.mem_request_ready = request_ready

    ram.read_enable = is_ram and cpu.mem_read_enable and request_ready
    ram.write_data = cpu.mem_write_data
    ram.mask = is_ram and request_ready ? cpu.mem_write_mask : fill!(4, false)

    // devices
    let leds = Reg[u32](clk, rst)
    uart_transmitter.data_valid = uart_write and request_ready

    if is_io and write_request and request_ready and word_addr[MemoryMappedIO::LEDs] {
        leds.d = uint!(cpu.mem_write_data)
    }

    if uart_write and request_ready {
        printf!("%c", cpu.mem_write_data[0])
    }

    let io_read_data = word_addr[MemoryMappedIO::UART_BUSY] ?
        cat!(22'b0, not uart_transmitter.ready, 9'b0) :
        32'd0

    // Both synchronous RAM and MMIO reads complete on the next enabled CPU
    // cycle. The valid bit is held between enables, alongside the read data.
    let read_response_valid = Reg[bool](clk, rst, en: cpu_enable)
    read_response_valid.d = cpu.mem_read_enable and request_ready
    cpu.mem_read_data_valid = read_response_valid.q
    cpu.mem_read_data = is_ram ? ram.q : io_read_data

    led = leds.q[7:0]
    io_led = cpu.status
    halted = cpu.halted
    trap = cpu.trap
}
