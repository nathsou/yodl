
// https://gist.github.com/olofk/e91fba2572396f55525f8814f05fb33d
module Transmitter[ClockFreq: Nat, BaudRate: Nat](
    clk: clock,
    rst: bool,
    data_in: u8,
    data_valid: bool, 
) -> (
    tx: u1,
    ready: bool,
) {
    // Parameters require ClockFreq >= BaudRate > 0. Each frame contains one
    // start bit, eight data bits (least significant first), and one stop bit.
    const CYCLES_PER_BIT = ClockFreq / BaudRate
    // cdiv!(n, n) is one for a valid positive divisor and rejects configurations
    // where integer division would otherwise produce zero cycles per bit.
    const COUNTER_WIDTH = clog2!(CYCLES_PER_BIT + cdiv!(CYCLES_PER_BIT, CYCLES_PER_BIT))
    let counter = Reg[uint[COUNTER_WIDTH]](clk, rst)
    let data = Reg[u10](clk, rst)
    let bits_remaining = Reg[u4](clk, rst)
    let idle = bits_remaining.q == 0

    if data_valid and idle {
        data.d = cat!(1'b1, data_in, 1'b0)
        bits_remaining.d = 10
        counter.d = CYCLES_PER_BIT - 1
    } else if not idle {
        if counter.q == 0 {
            data.d = cat!(1'b1, data.q[9:1])
            bits_remaining.d = bits_remaining.q - 1
            counter.d = CYCLES_PER_BIT - 1
        } else {
            counter.d = counter.q - 1
        }
    }

    tx = idle ? 1 : data.q[0]
    ready = idle
}
