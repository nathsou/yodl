
module SevenSegmentDecoder(char: logic[4]) -> (segs: logic[7]) {
    segs = match char {
        4'h0 => 7'b0111111,
        4'h1 => 7'b0000110,
        4'h2 => 7'b1011011,
        4'h3 => 7'b1001111,
        4'h4 => 7'b1100110,
        4'h5 => 7'b1101101,
        4'h6 => 7'b1111101,
        4'h7 => 7'b0000111,
        4'h8 => 7'b1111111,
        4'h9 => 7'b1100111,
        4'ha => 7'b1110111,
        4'hb => 7'b1111100,
        4'hc => 7'b0111001,
        4'hd => 7'b1011110,
        4'he => 7'b1111001,
        4'hf => 7'b1110001,
    };
}

module Multi(
    clk: logic,
    rst: logic,
    value: logic[16],
) -> (
    segs: logic[8],
    sel: logic[4],
) {
    let counter = Reg<13>(clk, rst);
    counter.d = counter.q + 1;

    let active_seg = match counter.q[12:11] {
        2'b00 => { char: value[3:0], sel: 4'b1110 },
        2'b01 => { char: value[7:4], sel: 4'b1101 },
        2'b10 => { char: value[11:8], sel: 4'b1011 },
        2'b11 => { char: value[15:12], sel: 4'b0111 },
    };

    sel = active_seg.sel;
    segs = [1'b0, ...(not SevenSegmentDecoder(char: active_seg.char).segs)];
}
