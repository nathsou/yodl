// yosys -p "read_rtlil output/FullAdder.rtlil; check -assert; write_verilog output/FullAdder.v"

module FullAdder(
    a: logic,
    b: logic,
    carry_in: logic,
) -> (
    sum: logic,
    carry_out: logic,
) {
    let xor1 = a xor b;
    sum = carry_in xor xor1;
    carry_out = (carry_in and xor1) or (a and b);
}

module Adder<N>(
    a: logic[N],
    b: logic[N],
    carry_in: logic,
) -> (
    sum: logic[N],
    carry_out: logic,
) {
    let carry_chain: logic[N + 1];
    carry_chain[0] = carry_in;

    for i in 0..<N {
        FullAdder(
            a: a[i],
            b: b[i],
            carry_in: carry_chain[i],
            carry_out: carry_chain[i + 1],
            sum: sum[i],
        );
    }

    carry_out = carry_chain[N];
}

@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
)

// Nexys A7
module Top(
    clk: logic,
) -> (
    led: logic[16],
) {
    let counter = Reg<32>(clk);

    let adder = Adder<32>(
        a: counter.q,
        b: 32'1,
        carry_in: 1'0,
    );

    counter.d = adder.sum;

    led = adder.sum[31:16];
}
