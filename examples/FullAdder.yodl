// yosys -p "read_rtlil output/FullAdder.rtlil; check -assert; select Adder8; show -pause"

module FullAdder(
    a: logic,
    b: logic,
    carry_in: logic,
) -> (
    sum: logic,
    carry_out: logic,
) {
    let xor1 = a xor b;
    sum = carry_in xor xor1;
    carry_out = (carry_in and xor1) or (a and b);
}

module Adder8(
    a: logic[8],
    b: logic[8],
    carry_in: logic,
) -> (
    sum: logic[8],
    carry_out: logic,
) {
    let carry_chain: logic[9];
    carry_chain[0] = carry_in;

    for i in 0..<8 {
        FullAdder(
            a: a[i],
            b: b[i],
            carry_in: carry_chain[i],
            carry_out: carry_chain[i + 1],
            sum: sum[i],
        );
    }

    carry_out = carry_chain[8];
}
