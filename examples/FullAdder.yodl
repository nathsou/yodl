// yosys -p "read_rtlil output/FullAdder.rtlil; check -assert; write_verilog output/FullAdder.v"

module FullAdder(
    a: logic,
    b: logic,
    carry_in: logic,
) -> (
    sum: logic,
    carry_out: logic,
) {
    let xor1 = a xor b;
    sum = carry_in xor xor1;
    carry_out = (carry_in and xor1) or (a and b);
}

module Adder<N>(
    a: logic[N],
    b: logic[N],
    carry_in: logic,
) -> (
    sum: logic[N],
    carry_out: logic,
) {
    let carry_chain: logic[N + 1];
    carry_chain[0] = carry_in;

    for i in 0..<N {
        FullAdder(
            a: a[i],
            b: b[i],
            carry_in: carry_chain[i],
            carry_out: carry_chain[i + 1],
            sum: sum[i],
        );
    }

    carry_out = carry_chain[N];
}

// Nexys A7
module Top(
    sw: logic[16],
) -> (
    led: logic[16],
) {
    let adder = Adder<8>(
        a: sw[7:0],
        b: sw[15:8],
        carry_in: 1'0,
    );

    led = [...7'0, adder.carry_out, ...adder.sum];
}
