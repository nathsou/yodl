
module FullAdder(
    a: logic,
    b: logic,
    carry_in: logic,
) -> (
    sum: logic,
    carry_out: logic,
) {
    let xor1 = a xor b;
    sum = carry_in xor xor1;
    carry_out = (carry_in and xor1) or (a and b);
}

module Adder4(
    a: logic[4],
    b: logic[4],
    carry_in: logic,
) -> (
    sum: logic[4],
    carry_out: logic,
) {
    let adders: FullAdder[4];

    adders[0].a = a[0];
    adders[0].b = b[0];
    adders[0].carry_in = carry_in;

    adders[1].a = a[1];
    adders[1].b = b[1];
    adders[1].carry_in = adders[0].carry_out;

    adders[2].a = a[2];
    adders[2].b = b[2];
    adders[2].carry_in = adders[1].carry_out;

    adders[3].a = a[3];
    adders[3].b = b[3];
    adders[3].carry_in = adders[2].carry_out;

    sum[0] = adders[0].sum;
    sum[1] = adders[1].sum;
    sum[2] = adders[2].sum;
    sum[3] = adders[3].sum;
    carry_out = adders[3].carry_out;
}
