
module FullAdder(
    a: logic,
    b: logic,
    carry_in: logic,
) -> (
    sum: logic,
    carry_out: logic,
) {
    let xor1 = a xor b;
    sum = carry_in xor xor1;
    carry_out = (carry_in and xor1) or (a and b);
}

module Adder4(
    a: logic[4],
    b: logic[4],
    carry_in: logic,
) -> (
    sum: logic[4],
    carry_out: logic,
) {
    let adder0 = FullAdder(a: a[0], b: b[0], carry_in: carry_in);
    let adder1 = FullAdder(a: a[1], b: b[1], carry_in: adder0.carry_out);
    let adder2 = FullAdder(a: a[2], b: b[2], carry_in: adder1.carry_out);
    let adder3 = FullAdder(a: a[3], b: b[3], carry_in: adder2.carry_out);

    sum[0] = adder0.sum;
    sum[1] = adder1.sum;
    sum[2] = adder2.sum;
    sum[3] = adder3.sum;

    carry_out = adder3.carry_out;
}
