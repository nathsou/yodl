import VGA
import LFSR
import Timing

module Top(
    clk: logic,
    button: logic[4],
) -> (
    led: logic[4],
    vga_hsync: logic,
    vga_vsync: logic,
    vga_red: logic[3],
    vga_green: logic[3],
    vga_blue: logic[3],
) {
    let vga = VGA::SyncPulses(clk, hsync: vga_hsync, vsync: vga_vsync);
    let x_div = vga.col[9:2];
    let y_div = vga.row[9:2];
    let cell_idx: logic[15] = y_div * 160 + x_div;
    let timer = Timing::Timer<100_000>(clk);
    let rand_cell = LFSR::LFSR<15>(clk, enable: timer.q, seed_ready: 1'b0, seed_data: 15'0).q;
    let rand_color = LFSR::LFSR<3>(clk, enable: timer.q, seed_ready: 1'b0, seed_data: 3'0).q;
    let add_noise = button[0] or button[1] or button[2] or button[3];

    let color_idx = Memory<
        Width: 3,
        Depth: (VGA::H_ACTIVE / 4) * (VGA::V_ACTIVE / 4),
        ReadPorts: 1,
        WritePorts: 1,
        Init: $readmemb("res/york.mem"),
    >(
        clk,
        read_addr: cell_idx,
        write_addr: rand_cell,
        write_enable: add_noise and timer.q,
        data_in: rand_color,
    ).data_out;

    let color = match vga.is_active_area {
        1'b0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'b1 => match color_idx {
            3'd0 => { r: 3'd3, g: 3'd5, b: 3'd7 },
            3'd1 => { r: 3'd2, g: 3'd2, b: 3'd2 },
            3'd2 => { r: 3'd0, g: 3'd0, b: 3'd0 },
            3'd3 => { r: 3'd1, g: 3'd1, b: 3'd0 },
            3'd4 => { r: 3'd1, g: 3'd1, b: 3'd1 },
            3'd5 => { r: 3'd7, g: 3'd7, b: 3'd6 },
            3'd6 => { r: 3'd7, g: 3'd7, b: 3'd7 },
            3'd7 => { r: 3'd3, g: 3'd3, b: 3'd3 },
        },
    };

    vga_red = color.r;
    vga_green = color.g;
    vga_blue = color.b;
    led = 4*{add_noise};
}
