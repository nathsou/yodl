
@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
);

module ProgramCounter(
    clk: logic,
    rst: logic,
    jump: logic,
    jump_addr: logic[16],
) -> (
    q: logic[16],
) {
    let pc = Reg<16>(clk, rst, q);
    pc.d = jump ? jump_addr : pc.q + 1'1;
}

module RegisterFile<WIDTH, DEPTH>(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[$clog2(DEPTH)],
    write_data: logic[WIDTH],
    read_src: logic[$clog2(DEPTH)],
    data_out: logic,
) -> (
    reg0_data: logic[WIDTH],
    reg1_data: logic[WIDTH],
    read_data: logic[WIDTH],
) {
    let regs = (DEPTH)x[Reg<WIDTH>(clk, rst, d: write_data)];

    for i in 0..<DEPTH {
        regs[i].en = write_enable and (write_dest == i);
    }

    reg0_data = regs[0].q;
    reg1_data = regs[1].q;
    // read_data = data_out ? regs[read_src].q : (WIDTH)x{1'z};
    read_data = regs[read_src].q;
}

module Top(clk: logic, rst_n: logic) -> () {
    let rst = not rst_n;
    RegisterFile<8, 8>(clk, rst);
}
