
@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
);

module ProgramCounter(
    clk: logic,
    rst: logic,
    jump: logic,
    jump_addr: logic[16],
) -> (
    q: logic[16],
) {
    let pc = Reg<16>(clk, rst, q);
    pc.d = jump ? jump_addr : pc.q + 1'1;
}

module RegisterFile(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[3],
    write_data: logic[16],
    read_src1: logic[3],
    read_src2: logic[3],
) -> (
    read_data1: logic[16],
    read_data2: logic[16],
) {
    let regs: logic[16][8];

    regs[0] = 16'0;

    for i in 1..=6 {
        regs[i] = Reg<16>(
            clk,
            rst,
            en: write_enable and (write_dest == i),
            d: write_data,
        ).q;
    }

    regs[7] = ProgramCounter(
        clk,
        rst,
        jump: write_enable and (write_dest == 3'7),
        jump_addr: write_data,
    ).q;

    read_data1 = regs[read_src1];
    read_data2 = regs[read_src2];
}
