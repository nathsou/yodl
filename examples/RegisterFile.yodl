
@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
);

module ProgramCounter(
    clk: logic,
    rst: logic,
    jump: logic,
    jump_addr: logic[16],
) -> (
    q: logic[16],
) {
    let pc = Reg<16>(clk, rst, q);
    pc.d = jump ? jump_addr : pc.q + 1'1;
}

module RegisterFile(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[3],
    write_data: logic[16],
    read_src1: logic[3],
    read_src2: logic[3],
) -> (
    read_data1: logic[16],
    read_data2: logic[16],
) {
    let regs: logic[16][8];

    regs[0] = 16'0;

    for i in 1..=6 {
        regs[i] = Reg<16>(
            clk,
            rst,
            en: write_enable and (write_dest == i),
            d: write_data,
        ).q;
    }

    regs[7] = ProgramCounter(
        clk,
        rst,
        jump: write_enable and (write_dest == 3'7),
        jump_addr: write_data,
    ).q;

    read_data1 = regs[read_src1];
    read_data2 = regs[read_src2];
}

module Top(
    clk: logic,
    sw: logic[16],
    btn_c: logic,
) -> (
    led: logic[16],
) {
    let read_src1 = sw[14:12];
    let read_src2 = sw[11:9];
    let data = [...8'0, ...sw[7:0]];
    let write_enable = sw[15];

    let regs = RegisterFile(
        clk,
        rst: btn_c,
        write_enable,
        write_dest: read_src1,
        write_data: data,
        read_src1,
        read_src2,
    );

    led = write_enable ? data : [...regs.read_data1[7:0], ...regs.read_data2[7:0]];
}
