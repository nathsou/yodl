
module ProgramCounter(
    clk: uint<1>,
    rst: bool,
    jump: bool,
    jump_addr: uint<16>,
) -> (
    q: uint<16>,
) {
    let pc = Reg<uint<16>>(clk, rst, q);
    pc.d = jump ? jump_addr : pc.q + 1'1;
}

module RegisterFile<WIDTH, DEPTH>(
    clk: uint<1>,
    rst: bool,
    write_enable: bool,
    write_dest: uint<$clog2(DEPTH)>,
    write_data: uint<WIDTH>,
    read_src: uint<$clog2(DEPTH)>,
) -> (
    reg0_data: uint<WIDTH>,
    reg1_data: uint<WIDTH>,
    read_data: uint<WIDTH>,
) {
    let regs = DEPTH * [Reg<uint<WIDTH>>(clk, rst, d: write_data)];

    for i in 0..<DEPTH {
        regs[i].en = write_enable and (write_dest == i);
    }

    reg0_data = regs[0].q;
    reg1_data = regs[1].q;
    read_data = regs[read_src].q;
}

module Top(
    clk: uint<1>,
    rst: bool,
    write_enable: bool,
    write_dest: uint<3>,
    write_data: uint<8>,
    read_src: uint<3>,
) -> () {
    RegisterFile<8, 8>(clk, rst, write_enable, write_dest, write_data, read_src);
}
