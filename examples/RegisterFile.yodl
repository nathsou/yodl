
module ProgramCounter(
    clk: logic,
    rst: logic,
    jump: logic,
    jump_addr: logic[16],
) -> (
    q: logic[16],
) {
    let pc = Reg<16>(clk, rst, q);
    pc.d = jump ? jump_addr : pc.q + 1'1;
}

module RegisterFile<WIDTH, DEPTH>(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[$clog2(DEPTH)],
    write_data: logic[WIDTH],
    read_src: logic[$clog2(DEPTH)],
) -> (
    reg0_data: logic[WIDTH],
    reg1_data: logic[WIDTH],
    read_data: logic[WIDTH],
) {
    let regs = DEPTH * [Reg<WIDTH>(clk, rst, d: write_data)];

    for i in 0..<DEPTH {
        regs[i].en = write_enable and (write_dest == i);
    }

    reg0_data = regs[0].q;
    reg1_data = regs[1].q;
    read_data = regs[read_src].q;
}

module Top(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[3],
    write_data: logic[8],
    read_src: logic[3],
) -> () {
    RegisterFile<8, 8>(clk, rst, write_enable, write_dest, write_data, read_src);
}
