
@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
);

module RegisterFile(
    clk: logic,
    rst: logic,
    write_enable: logic,
    write_dest: logic[3],
    write_data: logic[16],
    read_src1: logic[3],
    read_src2: logic[3],
) -> (
    read_data1: logic[16],
    read_data2: logic[16],
) {
    let regs = [
        Reg<16>(clk, d: 16'0, en: 1'0),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'1)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'2)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'3)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'4)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'5)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'6)),
        Reg<16>(clk, rst, d: write_data, en: write_enable and (write_dest == 3'7)),
    ];

    read_data1 = regs[read_src1].q;
    read_data2 = regs[read_src2].q;
}
