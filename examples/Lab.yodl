import VGA

module Top(
    clk: uint<1>,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
    let vga = VGA::SyncPulses(pixel_clk: clk, col: screen_x, row: screen_y);
    let color = if vga.is_active_area {
        { r: 3'd3, g: 3'd5, b: 3'd7 };
    } else {
        { r: 3'd0, g: 3'd0, b: 3'd0 };
    };

    is_active_area = vga.is_active_area;
    r = color.r;
    g = color.g;
    b = color.b;
}
