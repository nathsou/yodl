
package State {
    const IDLE = 2'd0;
    const INCR = 2'd1;
    const DONE = 2'd2;
}

module Top(clk: logic) -> (rdy: logic) {
    let ready = Reg<1>(clk, q: rdy);
    let state = Reg<2>(clk);
    let counter = Reg<10>(clk);

    procedural {
        match state.q {
            State::IDLE => {
                state.d = State::INCR;
                ready.d = 1'b0;
            },
            State::INCR => {
                state.d = State::DONE;
                match counter.q {
                    10'd1000 => {
                        counter.d = 10'd0;
                    },
                    _ => {
                        counter.d = counter.q + 10'd1;
                    },
                };
            },
            State::DONE => {
                state.d = State::IDLE;
                ready.d = 1'b1;
            },
        };

        match counter.q {
            10'd211 => {
                counter.d = 10'300;
            },
        };
    }
}
