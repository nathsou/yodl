import LFSR

@simulation({
    top: "NoiseSim",
    "clock": "clk",
    framebuffer: { width: 400, height: 300, state_prefix: "pixel", mode: "rgb", packing: "rgb332x4", pixel_scale: 2 },
    init_signal: "rst",
    init_cycles: 1,
    frame_cycles: 1,
    clock_hz: 60,
    frame_rate: 30,
})
module NoiseSim(
    clk: clock,
    rst: bool,
) -> (pixel: [150][50]u32) {
    let random = LFSR::LFSR[32](clk, enable: not rst).q
    for row in 0..<150 {
        for col in 0..<50 {
            // Mix the frame counter with the pixel coordinate and pack four
            // RGB332 pixels per output word. Each source pixel expands to a
            // 2x2 display block.
            const x0 = col * 8
            const x1 = x0 + 2
            const x2 = x0 + 4
            const x3 = x0 + 6
            const y = row * 2
            let mix0 = random xor uint!(y * 37 + x0 * 101)
            let mix1 = random xor uint!(y * 37 + x1 * 101)
            let mix2 = random xor uint!(y * 37 + x2 * 101)
            let mix3 = random xor uint!(y * 37 + x3 * 101)
            let color0 = cat!(mix0[2:0], mix0[5:3], mix0[8:7])
            let color1 = cat!(mix1[2:0], mix1[5:3], mix1[8:7])
            let color2 = cat!(mix2[2:0], mix2[5:3], mix2[8:7])
            let color3 = cat!(mix3[2:0], mix3[5:3], mix3[8:7])
            pixel[row][col] = cat!(color3, color2, color1, color0)
        }
    }
}
