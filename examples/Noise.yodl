import VGA
import LFSR

// Logical noise source used by the playground. The hardware Top below keeps
// the VGA timing path; simulation renders the same kind of RGB noise directly
// without spending 420,000 cycles on a VGA scan.
@simulation({
    top: "NoiseSim",
    "clock": "clk",
    framebuffer: { width: 40, height: 30, state_prefix: "pixel", mode: "rgb" },
    init_signal: "rst",
    init_cycles: 1,
    frame_cycles: 1,
    clock_hz: 60,
    frame_rate: 30,
})
module NoiseSim(
    clk: clock,
    rst: bool,
) -> (pixel: [30][40]u24) {
    let seed = Reg[u32](clk, rst)
    seed.d = seed.q + 32'd1
    for row in 0..<30 {
        for col in 0..<40 {
            // Mix the frame counter with the pixel coordinate. The hardware
            // LFSR advances once per VGA pixel; this equivalent hash keeps
            // the same changing, full-colour appearance at 40x30.
            const offset = row * 37 + col * 101
            let mix = seed.q xor uint!(offset)
            let red = cat!(mix[2:0], mix[2:0], mix[2:1])
            let green = cat!(mix[5:3], mix[5:3], mix[5:4])
            let blue = cat!(mix[8:6], mix[8:6], mix[8:7])
            pixel[row][col] = cat!(red, green, blue)
        }
    }
}

module Top(
    clk: clock,
) -> (
    led: u4,
    vga_hsync: bool,
    vga_vsync: bool,
    vga_red: u3,
    vga_green: u3,
    vga_blue: u3,
) {
    let vga = VGA::SyncPulses(pixel_clk: clk, hsync: vga_hsync, vsync: vga_vsync)
    let rand_color = LFSR::LFSR[32](clk, enable: vga.new_pixel).q[8:0]
    let color = match vga.is_active_area {
        1'b0 => (r: 3'd0, g: 3'd0, b: 3'd0)
        1'b1 => (r: rand_color[2-:3], g: rand_color[5-:3], b: rand_color[8-:3])
    }

    vga_red = color.r
    vga_green = color.g
    vga_blue = color.b
    led = 4'd0
}
