import Text

module Euler1(clk: uint<1>, rst: bool) -> (q: uint<18>, is_ready: bool) {
    const N = 1000;
    let counter = Reg<$clog2(N)>(clk, rst);
    let is_active = counter.q <: N;
    counter.d = counter.q + is_active;
    let sum = Reg<18>(clk, en: is_active, rst, q);
    let is_divisible = counter.q % 3 == 0 or counter.q % 5 == 0;
    sum.d = sum.q + (is_divisible ? counter.q : 0);
    is_ready = not is_active;
}

module TopSim(
    clk: uint<1>,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
    let vga = VGA::SyncPulses(pixel_clk: clk);
    let euler1 = Euler1(clk, rst);
    let hex = Text::Hex<20>(n: uint({2'0, euler1.q}));
    let text = Text::Text<Length: 40, X: 20, Y: 30>(
        text: {"The solution to Project Euler 1 is ", hex.chars},
        screen_x: vga.col,
        screen_y: vga.row,
    );

    let color = match vga.is_active_area and text.is_active {
        1'b0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'b1 => { r: 3'd1, g: 3'd3, b: 3'd6 },
    };

    r = color.r;
    g = color.g;
    b = color.b;
    is_active_area = vga.is_active_area;
    screen_x = vga.col;
    screen_y = vga.row;
}
