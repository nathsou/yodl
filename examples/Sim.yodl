import VGA

package State {
    const RED = 2'b00;
    const GREEN = 2'b01;
    const BLUE = 2'b10;
    const PINK = 2'b11;
}

module TopSim(
    clk: logic,
    rst: logic,
) -> (
    is_active_area: logic,
    screen_x: logic[10],
    screen_y: logic[10],
    r: logic[3],
    g: logic[3],
    b: logic[3],
) {
    let state = Reg<2>(clk, rst);
    let counter = Reg<25>(clk);
    let vga = VGA::SyncPulses(pixel_clk: clk, col: screen_x, row: screen_y, is_active_area);
    let color: logic[9];

    procedural {
        counter.d = counter.q + 1'd1;
        state.d = state.q;

        match vga.is_active_area {
            1'b0 => {
                color = 9'd0;
            },
            1'b1 => {
                match state.q {
                    State::RED => {
                        color = {3'd7, 3'd0, 3'd0};
                        match counter.q {
                            25*{1'b1} => {
                                state.d = State::GREEN;
                                counter.d = 25'd0;
                            },
                        };
                    },
                    State::GREEN => {
                        color = {3'd0, 3'd7, 3'd0};

                        match counter.q {
                            25'd16777215 => {
                                state.d = State::BLUE;
                                counter.d = 25'd0;
                            },
                        };
                    },
                    State::BLUE => {
                        color = {3'd0, 3'd0, 3'd7};

                        match counter.q {
                            25'd11184810 => {
                                state.d = State::PINK;
                                counter.d = 25'd0;
                            },
                        };
                    },
                    State::PINK => {
                        color = {3'd7, 3'd0, 3'd7};

                        match counter.q {
                            25'd8388608 => {
                                state.d = State::RED;
                                counter.d = 25'd0;
                            },
                        };
                    },
                };
            },
        };
    }

    r = color[8-:3];
    g = color[5-:3];
    b = color[2-:3];
}
