import VGA
import Life

// Fully parallel game of life simulation on a 640x480 VGA display (40 by 30 cells)
// adapted from https://k155la3.blog/2020/10/09/conways-game-of-life-on-fpga/

const CLOCK_FREQ = 25_000_000;

module TicTac<Max>(clk: uint<1>, en: bool, rst: bool) -> (tick: bool, count: uint<$clog2(Max)>) {
    let counter = Reg<$clog2(Max)>(clk, en, rst: rst or tick, q: count);
    counter.d = counter.q + 1;
    tick = counter.q == Max;
}

module TopSim(
    clk: uint<1>,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
    VGA::SyncPulses(
        pixel_clk: clk,
        is_active_area,
        col: screen_x,
        row: screen_y,
    );

    const Rows = VGA::V_ACTIVE / 16;
    const Cols = VGA::H_ACTIVE / 16;

    let x = (screen_x / 16)[5:0];
    let y = (screen_y / 16)[4:0];

    let sim_clk = TicTac<CLOCK_FREQ / 100>(clk, en: true, rst).tick;
    let grid = Life::GridInit<Rows, Cols>(
        rst,
        read_col: x,
        read_row: y,
    );

    grid.clk = grid.ready ? sim_clk : clk;

    let color = match is_active_area and grid.ready {
        1'0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'1 => {
            if grid.read_state {
                { r: 3'd7, g: 3'd7, b: 3'd7 };
            } else {
                { r: 3'd1, g: 3'd3, b: 3'd6 };
            }
        },
    };

    r = color.r;
    g = color.g;
    b = color.b;
}
