import VGA
import Life

module TopSim(
    clk: uint<1>,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
   let vga = VGA::SyncPulses(
        pixel_clk: clk,
        is_active_area,
        col: screen_x,
        row: screen_y,
    );

    let life = Life::Life(
        clk,
        rst,
        hsync: vga.hsync,
        vsync: vga.vsync,
        row: vga.row,
        col: vga.col,
    );

    let color = vga.is_active_area ? life.color : { r: 3'd0, g: 3'd0, b: 3'd0 };

    r = color.r;
    g = color.g;
    b = color.b;
}
