import Life

@simulation({
    top: "LifeSim",
    "clock": "clk",
    framebuffer: { width: 40, height: 30, state_prefix: "state", mode: "binary", on_color: 128676, off_color: 0 },
    init_signal: "init",
    init_cycles: 1,
    frames: 60,
    frame_cycles: 1,
    clock_hz: 60,
    frame_rate: 30,
})
module LifeSimulationConfig() -> () {}
