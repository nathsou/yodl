import VGA
import Life

const CLOCK_FREQ = 25_000_000;

module TicTac<Max>(clk: uint<1>, en: bool, rst: bool) -> (tick: bool, count: uint<$clog2(Max)>) {
    let counter = Reg<$clog2(Max)>(clk, en, rst: rst or tick, q: count);
    counter.d = counter.q + 1;
    tick = counter.q == Max;
}

module TopSim(
    clk: uint<1>,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
   let vga = VGA::SyncPulses(
        pixel_clk: clk,
        is_active_area,
        col: screen_x,
        row: screen_y,
    );

    const Rows = VGA::V_ACTIVE / 16;
    const Cols = VGA::H_ACTIVE / 16;

    let x = screen_x[9:4];
    let y = screen_y[8:4];

    // Gosper glider gun and a glider eater
    let pattern: bool[Cols][Rows] = [
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000010000000000000},
        {40'b0000000000000000000000001010000000000000},
        {40'b0000000000000011000000110000000000001100},
        {40'b0000000000000100010000110000000000001100},
        {40'b0011000000001000001000110000000000000000},
        {40'b0011000000001000101100001010000000000000},
        {40'b0000000000001000001000000010000000000000},
        {40'b0000000000000100010000000000000000000000},
        {40'b0000000000000011000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000000000},
        {40'b0000000000000000000000000000000000001100},
        {40'b0000000000000000000000000000000000001010},
        {40'b0000000000000000000000000000000000000010},
        {40'b0000000000000000000000000000000000000011},
        {40'b0000000000000000000000000000000000000000},
    ];

    let grid = Life::GridInit<Rows, Cols>(
        rst,
        read_col: x,
        read_row: y,
        pattern,
    );

    grid.clk = grid.ready ? vga.vsync : clk;

    let color = match is_active_area and grid.ready {
        1'0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'1 => {
            if screen_x[3:0] == 0 or screen_y[3:0] == 0 {
                { r: 3'd1, g: 3'd1, b: 3'd1 };
            } else if grid.read_state {
                { r: 3'd1, g: 3'd6, b: 3'd4 };
            } else {
                { r: 3'd0, g: 3'd0, b: 3'd0 };
            }
        },
    };

    r = color.r;
    g = color.g;
    b = color.b;
}
