import Text

module Euler1(clk: logic, rst: logic) -> (q: logic[18], is_ready: logic) {
    const N = 1000;
    const CounterWidth = $clog2(N);
    let counter = Reg<CounterWidth>(clk, rst);
    let is_active = counter.q <= N - 1;
    counter.d = counter.q + is_active;
    let sum = Reg<18>(clk, en: is_active, rst, q);
    let is_divisible = counter.q % 3 == 0 or counter.q % 5 == 0;
    sum.d = sum.q + (is_divisible ? counter.q : CounterWidth * {1'0});
    is_ready = not is_active;
}

module TopSim(
    clk: logic,
    rst: logic,
) -> (
    is_active_area: logic,
    screen_x: logic[10],
    screen_y: logic[10],
    r: logic[3],
    g: logic[3],
    b: logic[3],
) {
    let vga = VGA::SyncPulses(
        pixel_clk: clk,
        is_active_area,
        col: screen_x,
        row: screen_y,
    );

    let euler1 = Euler1(clk, rst);
    let bcd = Text::BCD<18>(bin: euler1.q).bcd;
    let hex = Text::Dec<24>(n: {1'b0, bcd});
    let text = Text::Text<Length: 41, X: 20, Y: 30>(
        text: {"The solution to Project Euler 1 is ", hex.chars},
        screen_x: vga.col,
        screen_y: vga.row,
    );

    let color = match vga.is_active_area and text.is_active {
        1'b0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'b1 => { r: 3'd2, g: 3'd6, b: 3'd4 },
    };

    r = color.r;
    g = color.g;
    b = color.b;
}
