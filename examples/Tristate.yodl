
module SevenSegment(char: logic[4]) -> (segs: logic[8]) {
    segs = match char {
        4'h0 => 8'b0111111,
        4'h1 => 8'b0000110,
        4'h2 => 8'b1011011,
        4'h3 => 8'b1001111,
        4'h4 => 8'b1100110,
        4'h5 => 8'b1101101,
        4'h6 => 8'b1111101,
        4'h7 => 8'b0000111,
        4'h8 => 8'b1111111,
        4'h9 => 8'b1100111,
        4'ha => 8'b1110111,
        4'hb => 8'b1111100,
        4'hc => 8'b0111001,
        4'hd => 8'b1011110,
        4'he => 8'b1111001,
        4'hf => 8'b1110001,
    };
}

module Segments(
    clk: logic,
    rst: logic,
    value: logic[16],
) -> (
    segs: logic[8],
    sel: logic[4],
) {
    let counter = Reg<13>(clk, rst);
    counter.d = counter.q + 1;

    let active_seg = match counter.q[12:11] {
        2'b00 => { char: value[3:0], sel: 4'b1110 },
        2'b01 => { char: value[7:4], sel: 4'b1101 },
        2'b10 => { char: value[11:8], sel: 4'b1011 },
        2'b11 => { char: value[15:12], sel: 4'b0111 },
    };

    sel = active_seg.sel;
    segs = not SevenSegment(char: active_seg.char).segs;
}

module Buffer<N>(d: logic[N], en: logic) -> (q: logic[N]) {
    q = en ? d : N x {1'bZ};
}

// Simulate pull-down resistors on the d port to fix
// an issue with the first revision of the Alchitry Io Element board
// see https://alchitry.com/tutorials/io-element/
module FakePullDown<SIZE>(
    clk: logic,
    d: @inout logic[SIZE],
) -> (
    q: logic[SIZE],
) {
    let flip = Reg<4>(clk);
    flip.d = flip.q + 1;
    Reg<SIZE>(clk, d, en: flip.q > 4'd2, q);
    d = flip.q == 4'0 ? SIZE x {1'b0} : SIZE x {1'bz};
}

module Top(
    clk: logic,
    io_sw: @inout logic[5],
    rst_n: logic,
) -> (
    io_led: logic[24],
    io_seg: logic[8],
    io_an: logic[4],
) {
    let rst = not rst_n;
    let chars: logic[16];
    
    Buffer<16>(d: 16'hBABA, en: io_sw[0], q: chars);
    Buffer<16>(d: 16'hF0FE, en: io_sw[1], q: chars);
    // Buffer<16>(d: 16'h0000, en: io_sw[0] nor io_sw[1], q: chars);
    Segments(clk, rst, value: chars, segs: io_seg, sel: io_an);

    let sw = FakePullDown<5>(clk, d: io_sw).q;
    io_led = [...sw, ...3'd0, ...chars];
}
