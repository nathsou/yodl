
module Dabble(bin: uint<4>) -> (q: uint<4>) {
    q = bin >= 4'd5 ? bin + 4'd3 : bin;
}

module BCD2(bin: uint<6>) -> (q: uint<8>) {
    let a = bin[5];
    let b = bin[4];
    let c = bin[3];
    let d = bin[2];
    let e = bin[1];
    let f = bin[0];

    let t = Dabble(bin: {1'b0, a, b, c}).q;
    let u = Dabble(bin: {t[2:0], d}).q;
    let v = Dabble(bin: {u[2:0], e}).q;

    q = {1'b0, t[3], u[3], v, f};
}

module Top(clk: clock) -> () {
    let bcd = BCD2(bin: 6'd11);
    $assert(bcd.q == 8'b0001_0001);
}
