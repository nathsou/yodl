import Text

const CLOCK_FREQ = 25_000_000; // 25 Mhz on Nandland Go

module Dabble(bin: logic[4]) -> (q: logic[4]) {
    q = bin >= 4'd5 ? bin + 4'd3 : bin;
}

module BCD2(bin: logic[6]) -> (q: logic[8]) {
    let a = bin[5];
    let b = bin[4];
    let c = bin[3];
    let d = bin[2];
    let e = bin[1];
    let f = bin[0];

    let t = Dabble(bin: {1'b0, a, b, c}).q;
    let u = Dabble(bin: {t[2:0], d}).q;
    let v = Dabble(bin: {u[2:0], e}).q;

    q = {1'b0, t[3], u[3], v, f};
}

module BCD3(bin: logic[8]) -> (q: logic[12]) {
    let a = bin[7];
    let b = bin[6];
    let c = bin[5];
    let d = bin[4];
    let e = bin[3];
    let f = bin[2];
    let g = bin[1];
    let h = bin[0];

    let t = Dabble(bin: {1'b0, a, b, c}).q;
    let u = Dabble(bin: {t[2:0], d}).q;
    let v = Dabble(bin: {u[2:0], e}).q;
    let w = Dabble(bin: {1'b0, t[3], u[3], v[3]}).q;
    let x = Dabble(bin: {v[2:0], f}).q;
    let y = Dabble(bin: {w[2:0], x[3]}).q;
    let z = Dabble(bin: {x[2:0], g}).q;

    q = {2'b0, w[3], y, z, h};
}

module TicTac<Max>(clk: logic, en: logic, rst: logic) -> (tick: logic, count: logic[$clog2(Max)]) {
    let counter = RegSyncReset<$clog2(Max)>(clk, en, rst: rst or tick, q: count);
    counter.d = counter.q + 1;
    tick = counter.q == Max - 1;
}

module ScreenClock(
    clk: logic,
    pixel_clk: logic,
    rst: logic,
) -> (
    is_active_area: logic,
    screen_x: logic[10],
    screen_y: logic[10],
    vga_hsync: logic,
    vga_vsync: logic,
    vga_red: logic[3],
    vga_green: logic[3],
    vga_blue: logic[3],
) {
    VGA::SyncPulses(
        pixel_clk,
        hsync: vga_hsync,
        vsync: vga_vsync,
        col: screen_x,
        row: screen_y,
        is_active_area,
    );

    let milliseconds = TicTac<CLOCK_FREQ / 1000>(clk, en: 1'b1, rst);
    let seconds = TicTac<60>(clk, en: milliseconds.tick, rst);
    let minutes = TicTac<60>(clk, en: seconds.tick, rst);
    let hours = TicTac<24>(clk, en: minutes.tick, rst);

    let seconds_dec = Text::Dec<8>(n: BCD2(bin: seconds.count).q).chars;
    let minutes_dec = Text::Dec<8>(n: BCD2(bin: minutes.count).q).chars;
    let hours_dec = Text::Dec<8>(n: BCD2(bin: {1'b0, hours.count}).q).chars;

    let text = Text::Text<Length: 8, X: 36, Y: 30>(
        text: {hours_dec, ":", minutes_dec, ":", seconds_dec},
        screen_x,
        screen_y,
    );

    let color = match is_active_area and text.is_active {
        1'b0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'b1 => { r: 3'd5, g: 3'd3, b: 3'd1 },
    };

    vga_red = color.r;
    vga_green = color.g;
    vga_blue = color.b;
}

module Top(
    clk: logic,
    button: logic[4],
) -> (
    led: logic[4],
    vga_hsync: logic,
    vga_vsync: logic,
    vga_red: logic[3],
    vga_green: logic[3],
    vga_blue: logic[3],
) {
    ScreenClock(
        clk,
        pixel_clk: clk,
        rst: button[0] or button[1] or button[2] or button[3],
        vga_hsync,
        vga_vsync,
        vga_red,
        vga_green,
        vga_blue,
    );

    led = 4*{1'b0};
}
