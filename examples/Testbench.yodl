module And(a: bool, b: bool) -> (out: bool) {
    out = a and b
}

module Pass[N: Nat](a: uint[N]) -> (out: uint[N]) {
    out = a
}

module ClockEcho(clk: clock, a: bool) -> (out: bool) {
    out = a
}

module Top(clk: clock, a: bool, b: bool, value: uint[8]) -> (
    and_out: bool,
    pass_out: uint[8],
    clock_out: bool,
) {
    and_out = And(a: a, b: b).out
    pass_out = Pass[8](a: value).out
    clock_out = ClockEcho(clk: clk, a: a).out
}

test "and gate" for And {
    drive!(a, true)
    drive!(b, false)
    expect!(out, false)
    drive!(b, true)
    expect!(out, true)
}

test "and gate unbound" {
    let dut = And()
    drive!(dut.a, true)
    drive!(dut.b, true)
    expect!(dut.out, true)
}

test "parameterized pass" for Pass[8] {
    drive!(a, 8'hab)
    expect!(out, 8'hab)
}

test "clocked test" for ClockEcho {
    drive!(a, true)
    step!(1)
    expect!(out, true)
}
