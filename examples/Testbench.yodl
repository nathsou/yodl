module XorGate(a: bool, b: bool) -> (out: bool) {
    out = a xor b
}

module Counter[Width: Nat](
    clk: clock,
    rst: bool,
    enable: bool,
) -> (value: uint[Width]) {
    let state = Reg[uint[Width]](clk, rst, en: enable)
    state.d = state.q + 1
    value = state.q
}

// Keep the example synthesizable through the normal compiler stages too.
module Top(clk: clock, rst: bool, enable: bool, a: bool, b: bool) -> (
    xor_out: bool,
    count: uint[8],
) {
    xor_out = XorGate(a: a, b: b).out
    count = Counter[8](clk: clk, rst: rst, enable: enable).value
}

test "complete XOR truth table" for XorGate {
    for lhs in 0..<2 {
        for rhs in 0..<2 {
            drive!(a, lhs)
            drive!(b, rhs)
            expect!(out, lhs xor rhs)
        }
    }
}

test "counter reset, increment, and hold" for Counter[8] {
    drive!(rst, true)
    drive!(enable, false)
    step!(1)
    expect!(value, 0)

    drive!(rst, false)
    drive!(enable, true)
    for expected in 1..<6 {
        step!(1)
        expect!(value, expected)
    }

    drive!(enable, false)
    step!(2)
    expect!(value, 5)
}
