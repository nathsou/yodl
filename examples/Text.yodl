        7'h4F => 64'h386CC6C6C66C3800,
        7'h50 => 64'hFC66667C6060F000,
        7'h51 => 64'h78CCCCCCDC781C00,
        7'h52 => 64'hFC66667C6C66E600,
        7'h53 => 64'h78CC603018CC7800,
