        7'h5E => 64'h10386CC600000000,
        7'h5F => 64'h00000000000000FF,
        7'h60 => 64'h3030180000000000,
        7'h61 => 64'h0000780C7CCC7600,
        7'h62 => 64'hE060607C6666DC00,
        7'h63 => 64'h000078CCC0CC7800,
        7'h64 => 64'h1C0C0C7CCCCC7600,
