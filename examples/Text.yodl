module CharAt<Length>(
    str: logic[Length * 7],
    index: logic[$clog2(Length)],
) -> (
    char: logic[7],
) {
    char = (str >> ((Length - 1 - index) * 7))[6:0];
}

module Top(
    clk: logic,
) -> (
    led: logic[4],
    vga_hsync: logic,
    vga_vsync: logic,
    vga_red: logic[3],
    vga_green: logic[3],
    vga_blue: logic[3],
) {
    const Rows = VGA::V_ACTIVE / 8;
    const Cols = VGA::H_ACTIVE / 8;

    let vga = VGA::SyncPulses(clk, hsync: vga_hsync, vsync: vga_vsync);
    let x_div = vga.col[9:3];
    let y_div = vga.row[9:3];
    let x = vga.col[2:0];
    let y = vga.row[2:0];
    let cell_idx: logic[13] = y_div * Cols + x_div;
    let message = " YODL; Yet anOther (hardware) Description Language by Nathan Soufflet!";
    let char = CharAt<Length: 70>(str: message, index: cell_idx[6:0]).char;
    let bitmap = AsciiTable(char).q;
    let pixel_idx: logic[6] = y * 8 + x;
    let pixel = bitmap[pixel_idx];
    let timer = Timer::Timer<25_000_000>(clk);
    let rand_color = LFSR::LFSR<32>(clk, enable: timer.q, seed_ready: 1'b0, seed_data: 32'd0).q[8:0];
    let color = match vga.is_active_area and pixel {
        1'b0 => { r: 3'd0, g: 3'd0, b: 3'd0 },
        1'b1 => { r: rand_color[2:0], g: rand_color[5:3], b: rand_color[8:6] },
    };

    vga_red = color.r;
    vga_green = color.g;
    vga_blue = color.b;
    led = 4'd0;
}
