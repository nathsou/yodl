        7'h3B => 64'h0030300000303060,
        7'h3C => 64'h183060C060301800,
        7'h3D => 64'h0000FC0000FC0000,
        7'h3E => 64'h6030180C18306000,
        7'h3F => 64'h78CC0C1830003000,
        7'h40 => 64'h7CC6DEDEDEC07800,
        7'h41 => 64'h3078CCCCFCCCCC00,
        7'h42 => 64'hFC66667C6666FC00,
        7'h43 => 64'h3C66C0C0C0663C00,
        7'h44 => 64'hF86C6666666CF800,
        7'h45 => 64'hFE6268786862FE00,
