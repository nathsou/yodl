import Text

module Euler1(clk: logic, rst: logic) -> (q: logic[18], is_ready: logic) {
    const N = 1000;
    const CounterWidth = $clog2(N);
    let counter = Reg<CounterWidth>(clk, rst);
    let is_active = counter.q <= N - 1;
    counter.d = counter.q + is_active;
    let sum = Reg<18>(clk, en: is_active, rst, q);
    let is_divisible = counter.q % 3 == 0 or counter.q % 5 == 0;
    sum.d = sum.q + (is_divisible ? counter.q : CounterWidth * {1'0});
    is_ready = not is_active;
}

module Top(
    clk: logic,
    button: logic[4],
) -> (
    led: logic[4],
    vga_hsync: logic,
    vga_vsync: logic,
    vga_red: logic[3],
    vga_green: logic[3],
    vga_blue: logic[3],
) {
    let rst = button[0] or button[1] or button[2] or button[3];
    let euler1 = Euler1(clk, rst);
    let hex = Text::Hex<20>(n: {2'b00, euler1.q});
    let text = Text::Text<Length: 40, X: 20, Y: 30>(
        clk,
        text: {"The solution to Project Euler 1 is ", hex.chars},
        color: {3'd1, 3'd5, 3'd6},
        vga_hsync,
        vga_vsync,
        vga_red,
        vga_green,
        vga_blue,
    );

    led = 4*{euler1.is_ready};
}
