  connect $vga.clk \clk
  connect \vga_hsync $vga.hsync
  connect \vga_vsync $vga.vsync
  connect \x_div $vga.col [9:2]
  connect \y_div $vga.row [9:2]
  connect \cell_idx $add_33.y
  connect $timer.clk \clk
  connect $LFSR$1_36.clk \clk
  connect $LFSR$1_36.enable $timer.q
  connect $LFSR$1_36.seed_ready 1'0
  connect $LFSR$1_36.seed_data 15'000000000000000
  connect \rand_cell $LFSR$1_36.q
  connect $LFSR$2_37.clk \clk
  connect $LFSR$2_37.enable $timer.q
  connect $LFSR$2_37.seed_ready 1'0
  connect $LFSR$2_37.seed_data 3'000
  connect \rand_color $LFSR$2_37.q
  connect \add_noise $or_38.y
  connect $Memory_41.clk \clk
  connect $Memory_41.read_addr \cell_idx
  connect $Memory_41.write_addr \rand_cell
  connect $Memory_41.write_enable $and_42.y
  connect $Memory_41.data_in \rand_color
  connect \color_idx $Memory_41.data_out
  connect \color $mux_43.y
  connect \vga_red \color [2:0]
  connect \vga_green \color [5:3]
  connect \vga_blue \color [8:6]
  connect \led { \add_noise \add_noise \add_noise \add_noise }
end
