
@internal
declare module Reg<N>(
    clk: logic,
    d: logic[N],
    en?: logic,
    rst?: logic,
) -> (
    q: logic[N],
);

module Top(
    clk: logic,
    sw: logic[16],
    btn_c: logic,
) -> (
    led: logic[16],
) {
    let counter = Reg<32>(clk: clk, rst: btn_c);
    counter.d = (counter.q + sw)[31:0];
    led = counter.q[31:16];
}
