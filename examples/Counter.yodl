
declare module $dff<WIDTH, CLK_POLARITY>(
    CLK: logic,
    D: logic[WIDTH],
) -> (
    Q: logic[WIDTH],
);

module Reg<N>(
    clk: logic,
    d: logic[N],
) -> (
    q: logic[N],
) {
    $dff<N, 1>(
        CLK: clk,
        D: d,
        Q: q,
    );
}

module Top(
    clk: logic,
    sw: logic[16],
) -> (
    led: logic[16],
) {
    let counter = Reg<32>(clk: clk);
    counter.d = (counter.q + sw)[31:0];
    led = counter.q[31:16];
}
