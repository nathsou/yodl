{
    "name": "yodl",
    "scopeName": "source.yodl",
    "patterns": [
        {
            "name": "comment.line.double-slash.yodl",
            "match": "//.*$"
        },
        {
            "name": "keyword.control.yodl",
            "match": "\\b(declare|module|let|match|if|else|for|in|const|package|import)\\b"
        },
        {
            "name": "entity.name.function.yodl",
            "match": "[A-Za-z_0-9]+!"
        },
        {
            "name": "storage.type.sized.yodl",
            "match": "\\b[us]\\d+\\b"
        },
        {
            "name": "storage.type.yodl",
            "match": "\\b(uint|sint|bool|clock|type|Nat|Type)\\b"
        },
        {
            "name": "constant.numeric.yodl",
            "match": "\\b\\d+'[bhod]?[A-Za-z0-9_]+\\b|\\b\\d+(?:_\\d+)*\\b"
        },
        {
            "name": "punctuation.separator.parameters.yodl",
            "match": "[(){}\\[\\],;:]|(->)|(=>)|(::)"
        },
        {
            "name": "keyword.operator.yodl",
            "match": "(andr|orr|xorr|and|or|not|xor|nand|nor|xnor|shl|shr|==|!=|<=|>=|<:|>:|\\+:|-:|\\.\\.<|\\.\\.=|\\.\\.|\\+|-|\\*|/|%|\\?|\\.)"
        },
        {
            "name": "keyword.other.yodl",
            "match": "\\b(true|false)\\b"
        },
        {
            "name": "keyword.other.attribute.yodl",
            "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
            "name": "entity.name.identifier.yodl",
            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
            "name": "string.quoted.double.yodl",
            "match": "\"(?:\\\\\"|[^\"])*\""
        },
        {
            "name": "string.quoted.single.yodl",
            "match": "'(?:\\\\'|[^'])*'"
        }
    ],
    "fileTypes": [
        "yodl"
    ]
}
